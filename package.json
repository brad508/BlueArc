{
  "name": "bluearc-content-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "doctor": "node tools/hyperframes.mjs doctor",
    "check": "node tools/hyperframes.mjs check projects/pipeline-test --strict --at 0.2,0.5,0.8,1.5,2.9",
    "render:test": "node tools/hyperframes.mjs render projects/pipeline-test --fps 30 --workers 2 --strict-all -o exports/bluearc-pipeline-test.mp4",
    "postinstall": "node tools/prepare.mjs",
    "preview:test": "node tools/hyperframes.mjs preview projects/pipeline-test --background"
  },
  "devDependencies": {
    "gsap": "3.14.2",
    "hyperframes": "0.8.115"
  }
}
